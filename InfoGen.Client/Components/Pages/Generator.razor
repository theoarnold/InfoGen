@page "/generate"
@using System.Net
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<Generator> Logger
@rendermode InteractiveWebAssembly

<PageTitle>@(generatedArticle != null ? $"{generatedArticle.Title} - Ficipedia" : "Generate Article - Ficipedia")</PageTitle>

@if (!isLoading && generatedArticle == null)
{
    <div class="hero-section generator-panel generator-form-wrapper">
        <div class="generator-auth-bar">
            <div class="generator-form-auth">
                <span class="generator-status-dot" aria-hidden="true"></span>
                <span class="generator-title">AI Wiki Generator - Beta</span>
                <AuthorizeView>
                    <Authorized>
                        <a href="Account/Profile" class="auth-profile-link">Profile</a>
                    </Authorized>
                    <NotAuthorized>
                        <span></span>
                        <a href="Account/Login" class="auth-login-btn">Login</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
        @if (usageStatus is not null)
        {
            <p class="generator-usage-line">
                <strong>@usageStatus.TotalAvailable</strong> generation@(usageStatus.TotalAvailable == 1 ? "" : "s") left
            </p>
        }
        <p class="generator-hint-bold">@(showRestOfForm ? "Want to add more?" : (showSecondBox ? "Add another..." : "Enter your first source article..."))</p>
        <div class="manual-inputs">
            @* Row 0: always visible *@
            @{ var idx0 = 0; }
            <div class="manual-input-row @(SuggestionsOpen(idx0) ? "manual-input-row-dropdown-open" : "")">
                <div class="manual-input-suggest-wrapper search-input-wrapper">
                    <input type="text"
                           class="@ManualInputClass(idx0)"
                           placeholder="Search Wikipedia..."
                           value="@manualUrls[idx0]"
                           @oninput="@(e => OnManualUrlChanged(idx0, e.Value?.ToString()))"
                           @onblur="@OnFirstInputBlur" />
                    <span class="search-input-icon" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                    </span>
                    @if (suggestionsLoading[idx0])
                    {
                        <span class="suggest-loading">Searching...</span>
                    }
                    @if (suggestions[idx0] != null && suggestions[idx0]!.Count > 0)
                    {
                        <ul class="suggest-dropdown" role="listbox">
                            @foreach (var title in suggestions[idx0]!)
                            {
                                <li role="option" class="suggest-item"
                                    @onmousedown:preventDefault
                                    @onclick="@(() => SelectSuggestion(idx0, title))">@title</li>
                            }
                        </ul>
                    }
                </div>
                @if (manualValidation[idx0] == false)
                {
                    <span class="manual-input-error">Not a valid Wikipedia article</span>
                }
            </div>
            @{
                var showRandomizeRow = (!FirstFilled && !randomizeRowHiddenAfterFirstEntry) || randomizeFading || wrapperCollapsing;
                var randomizeWrapperExpanded = (!FirstFilled && !randomizeRowHiddenAfterFirstEntry) || randomizeFading;
            }
            <div class="randomize-row-wrapper @(randomizeWrapperExpanded ? "randomize-row-wrapper--expanded" : "") @(wrapperCollapsing ? "randomize-row-wrapper--collapsing" : "")">
                @if (showRandomizeRow)
                {
                    <div class="randomize-row @(randomizeFading ? "randomize-row-fade-out" : "") @(wrapperCollapsing ? "randomize-row-invisible" : "")">
                        <span class="randomize-label">Or just…</span>
                        <button type="button" class="btn-randomize" @onclick="GenerateArticle">Randomize</button>
                    </div>
                }
            </div>
            @* Row 1: revealed after user leaves first box with content; wrapper fades in *@
            <div class="second-box-wrapper @(showSecondBox ? "visible" : "")">
                @{ var idx1 = 1; }
                <div class="manual-input-row @(SuggestionsOpen(idx1) ? "manual-input-row-dropdown-open" : "")">
                    <div class="manual-input-suggest-wrapper search-input-wrapper">
                        <input type="text"
                               class="@ManualInputClass(idx1)"
                               placeholder="Search Wikipedia..."
                               value="@manualUrls[idx1]"
                               @oninput="@(e => OnManualUrlChanged(idx1, e.Value?.ToString()))"
                               @onblur="@OnSecondInputBlur" />
                        <span class="search-input-icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                        </span>
                        @if (suggestionsLoading[idx1])
                        {
                            <span class="suggest-loading">Searching...</span>
                        }
                        @if (suggestions[idx1] != null && suggestions[idx1]!.Count > 0)
                        {
                            <ul class="suggest-dropdown" role="listbox">
                                @foreach (var title in suggestions[idx1]!)
                                {
                                    <li role="option" class="suggest-item"
                                        @onmousedown:preventDefault
                                        @onclick="@(() => SelectSuggestion(idx1, title))">@title</li>
                                }
                            </ul>
                        }
                    </div>
                    @if (manualValidation[idx1] == false)
                    {
                        <span class="manual-input-error">Not a valid Wikipedia article</span>
                    }
                </div>
            </div>
            @* Boxes 3 & 4 + tone, advanced, actions: reveal only after user commits second box (blur or select) *@
            @if (showRestOfForm)
            {
                var idx2 = 2;
                <div class="form-reveal-group">
                    <div class="manual-input-row @(SuggestionsOpen(idx2) ? "manual-input-row-dropdown-open" : "")">
                        <div class="manual-input-suggest-wrapper search-input-wrapper">
                            <input type="text"
                                   class="@ManualInputClass(idx2)"
                                   placeholder="Search Wikipedia..."
                                   value="@manualUrls[idx2]"
                                   @oninput="@(e => OnManualUrlChanged(idx2, e.Value?.ToString()))"
                                   @onblur="@(() => CloseSuggestionsAfterDelay(idx2))" />
                            <span class="search-input-icon" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                            </span>
                            @if (suggestionsLoading[idx2])
                            {
                                <span class="suggest-loading">Searching...</span>
                            }
                            @if (suggestions[idx2] != null && suggestions[idx2]!.Count > 0)
                            {
                                <ul class="suggest-dropdown" role="listbox">
                                    @foreach (var title in suggestions[idx2]!)
                                    {
                                        <li role="option" class="suggest-item"
                                            @onmousedown:preventDefault
                                            @onclick="@(() => SelectSuggestion(idx2, title))">@title</li>
                                    }
                                </ul>
                            }
                        </div>
                        @if (manualValidation[idx2] == false)
                        {
                            <span class="manual-input-error">Not a valid Wikipedia article</span>
                        }
                        <span class="manual-input-optional">Optional</span>
                    </div>
                    @{ var idx3 = 3; }
                    <div class="manual-input-row @(SuggestionsOpen(idx3) ? "manual-input-row-dropdown-open" : "")">
                        <div class="manual-input-suggest-wrapper search-input-wrapper">
                            <input type="text"
                                   class="@ManualInputClass(idx3)"
                                   placeholder="Search Wikipedia..."
                                   value="@manualUrls[idx3]"
                                   @oninput="@(e => OnManualUrlChanged(idx3, e.Value?.ToString()))"
                                   @onblur="@(() => CloseSuggestionsAfterDelay(idx3))" />
                            <span class="search-input-icon" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                            </span>
                            @if (suggestionsLoading[idx3])
                            {
                                <span class="suggest-loading">Searching...</span>
                            }
                            @if (suggestions[idx3] != null && suggestions[idx3]!.Count > 0)
                            {
                                <ul class="suggest-dropdown" role="listbox">
                                    @foreach (var title in suggestions[idx3]!)
                                    {
                                        <li role="option" class="suggest-item"
                                            @onmousedown:preventDefault
                                            @onclick="@(() => SelectSuggestion(idx3, title))">@title</li>
                                    }
                                </ul>
                            }
                        </div>
                        @if (manualValidation[idx3] == false)
                        {
                            <span class="manual-input-error">Not a valid Wikipedia article</span>
                        }
                        <span class="manual-input-optional">Optional</span>
                    </div>
                    <div class="tone-slider-section tone-slider-section--stacked">
                        <span class="tone-slider-label">Tone</span>
                        <div class="tone-slider-wrap">
                            <div class="tone-slider-track-wrap">
                                <input type="range" min="0" max="2" step="1" class="tone-slider"
                                       value="@((int)selectedTone)" @oninput="OnToneSliderInput" />
                            </div>
                            <div class="tone-slider-labels">
                                <span class="tone-label @(selectedTone == ArticleTone.Realistic ? "active" : "")">Realistic</span>
                                <span class="tone-label @(selectedTone == ArticleTone.Fun ? "active" : "")">Fun</span>
                                <span class="tone-label @(selectedTone == ArticleTone.Crazy ? "active" : "")">Crazy</span>
                            </div>
                        </div>
                    </div>
                    <div class="advanced-section">
            <button type="button" class="advanced-section-header @(moreSectionExpanded ? "expanded" : "")"
                    @onclick="ToggleMoreSection"
                    aria-expanded="@moreSectionExpanded"
                    aria-controls="advanced-section-content">
                <span class="advanced-section-label">Advanced</span>
                <span class="advanced-section-chevron" aria-hidden="true">▼</span>
            </button>
            <div id="advanced-section-content" class="advanced-section-content @(moreSectionExpanded ? "expanded" : "collapsed")">
                <div class="advanced-section-content-inner">
                <div class="manual-input-row reference-section-row">
                    <span class="manual-input-label additional-prompt-spacer"></span>
                    <div class="reference-section reference-section-content">
                        <div class="additional-prompt-title-row reference-section-title-row">
                            <label class="reference-section-label">Add Reference</label>
                            <span class="manual-input-optional additional-prompt-optional-mobile">Optional</span>
                        </div>
                        <p class="reference-section-hint">Link to up to 5 existing Ficipedia articles so the AI can reference them in the body (they become blue links).</p>
                        <div class="reference-search-wrap search-input-wrapper">
                            <input type="text"
                                   class="reference-search-input"
                                   placeholder="Search saved articles..."
                                   value="@referenceSearchQuery"
                                   @oninput="OnReferenceSearchInput"
                                   @onblur="CloseReferenceSuggestAfterDelay" />
                            <span class="search-input-icon" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                            </span>
                            @if (referenceSearchLoading)
                            {
                                <span class="suggest-loading">Searching...</span>
                            }
                            @if (referenceSearchResults != null && referenceSearchResults.Count > 0)
                            {
                                <ul class="suggest-dropdown reference-suggest-dropdown" role="listbox">
                                    @foreach (var hit in referenceSearchResults)
                                    {
                                        var article = hit;
                                        <li role="option" class="suggest-item"
                                            @onmousedown:preventDefault
                                            @onclick="@(() => AddReference(article))">
                                            @article.Title
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                        @if (selectedReferences.Count > 0)
                        {
                            <ul class="reference-chips">
                                @foreach (var refLink in selectedReferences)
                                {
                                    var r = refLink;
                                    <li>
                                        <a href="/wiki/@r.Slug" class="reference-chip-title">@r.Title</a>
                                        <button type="button" class="reference-chip-remove" @onclick="@(() => RemoveReference(r))" aria-label="Remove">×</button>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                    <span class="manual-input-optional additional-prompt-optional-desktop">Optional</span>
                </div>

                <div class="manual-input-row additional-prompt-row">
                    <span class="manual-input-label additional-prompt-spacer"></span>
                    <div class="additional-prompt-wrapper">
                        <div class="additional-prompt-title-row">
                            <label class="additional-prompt-label" for="additional-prompt-input">Additional prompt</label>
                            <span class="manual-input-optional additional-prompt-optional-mobile">Optional</span>
                        </div>
                        <textarea id="additional-prompt-input"
                                  class="additional-prompt-input"
                                  placeholder="Add extra guidance for subject matter or tone (max 100 words)"
                                  rows="3"
                                  @bind="additionalPrompt"
                                  @bind:event="oninput" />
                        <span class="additional-prompt-count">@AdditionalPromptWordCount / 100 words</span>
                    </div>
                    <span class="manual-input-optional additional-prompt-optional-desktop">Optional</span>
                </div>
                </div>
            </div>
                    </div>
                    <div class="generator-actions">
                        <button class="btn-generate" @onclick="GenerateArticle" disabled="@(!CanGenerate)">
                            Generate Article
                        </button>
                    </div>
                </div>
        }
        </div>
    </div>
}
else if (isLoading)
{
    <div class="loading-section">
        <div class="loading-spinner">
            <div class="spinner"></div>
        </div>
        <p class="loading-status">@statusMessage</p>
        <div class="loading-steps">
            <div class="step @(currentStep >= 1 ? "active" : "") @(currentStep > 1 ? "done" : "")">
                <span class="step-dot"></span>
                <span>Fetching Wikipedia pages</span>
            </div>
            <div class="step @(currentStep >= 2 ? "active" : "") @(currentStep > 2 ? "done" : "")">
                <span class="step-dot"></span>
                <span>Generating mashup article</span>
            </div>
            <div class="step @(currentStep >= 3 ? "active" : "") @(currentStep > 3 ? "done" : "")">
                <span class="step-dot"></span>
                <span>Creating image with Nano Banana</span>
            </div>
        </div>
    </div>
}

@if (generatedArticle != null && !isLoading)
{
    <div class="wiki-article">
        <h1 class="wiki-title">@generatedArticle.Title</h1>
        <div class="wiki-from">From Ficipedia, the free fictional encyclopedia</div>
        <hr class="wiki-divider" />

        <div class="wiki-content-wrapper">
            @if (!string.IsNullOrEmpty(generatedArticle.ImageDataUrl) || generatedArticle.InfoboxFacts.Count > 0)
            {
                <div class="wiki-infobox">
                    <div class="infobox-header">@generatedArticle.Title</div>
                    @if (!string.IsNullOrEmpty(generatedArticle.ImageDataUrl))
                    {
                        <div class="infobox-image">
                            <img src="@generatedArticle.ImageDataUrl" alt="@generatedArticle.Title" />
                        </div>
                        <div class="infobox-caption">@generatedArticle.ImageDescription</div>
                    }
                    @if (generatedArticle.InfoboxFacts.Count > 0)
                    {
                        <table class="infobox-facts">
                            @foreach (var fact in generatedArticle.InfoboxFacts)
                            {
                                <tr>
                                    <th>@fact.Label</th>
                                    <td>@fact.Value</td>
                                </tr>
                            }
                        </table>
                    }
                </div>
            }

            <div class="wiki-body">
                @foreach (var articleSection in generatedArticle.Sections)
                {
                    @if (articleSection.Heading != null)
                    {
                        <h2 class="wiki-section-heading">@articleSection.Heading</h2>
                    }
                    @foreach (var paragraph in articleSection.Paragraphs)
                    {
                        <p>@((MarkupString)ReferenceLinkRenderer.ToHtml(paragraph, selectedReferences))</p>
                    }
                }
            </div>
        </div>

        <h2 class="wiki-section-heading" id="sources">
            <span>Source Articles</span>
        </h2>
        <hr class="wiki-section-divider" />
        <p class="sources-intro">This <strong>Fictional</strong> article was generated by mashing up the following <strong>@sourcePages.Count</strong> real Wikipedia articles:</p>
        <ol class="wiki-references">
            @foreach (var sourcePage in sourcePages)
            {
                <li>
                    <a href="@sourcePage.Url" target="_blank" rel="noopener noreferrer">@sourcePage.Title</a>
                    <span class="ref-extract"> — @Truncate(sourcePage.Extract, 150)</span>
                </li>
            }
        </ol>

        <div class="article-actions">
            <button type="button" class="btn-generate" @onclick="ReturnToGenerator">
                Generate Another
            </button>
            @if (!isSaved)
            {
                <button class="btn-save" @onclick="SaveArticle" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save Article</span>
                    }
                </button>
            }
            else
            {
                <a class="btn-save" href="/wiki/@savedSlug">View Saved Article</a>
            }
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="error-banner">
        <span class="error-icon">!</span>
        <div>
            <strong>Something went wrong</strong>
            <p>@errorMessage</p>
        </div>
        <button class="btn-generate btn-small" @onclick="GenerateArticle">Try Again</button>
    </div>
}

@code {
    private GeneratedArticle? generatedArticle;
    private List<WikipediaPage> sourcePages = new();
    private string? sessionToken;
    private bool isLoading;
    private bool isSaving;
    private bool isSaved;
    private string? savedSlug;
    private string statusMessage = "";
    private string? errorMessage;
    private int currentStep;

    private UsageStatusResponse? usageStatus;

    private string[] manualUrls = new string[4] { "", "", "", "" };
    private bool?[] manualValidation = new bool?[4] { null, null, null, null };

    private List<string>?[] suggestions = new List<string>?[4] { null, null, null, null };
    private bool[] suggestionsLoading = new bool[4];
    private CancellationTokenSource?[] suggestCts = new CancellationTokenSource?[4];

    private ArticleTone selectedTone = ArticleTone.Fun;

    private string additionalPrompt = "";

    private bool moreSectionExpanded;

    private string referenceSearchQuery = "";
    private List<SavedArticleSummary>? referenceSearchResults;
    private bool referenceSearchLoading;
    private CancellationTokenSource? referenceSearchCts;
    private List<ReferenceLink> selectedReferences = new();

    private const int MaxReferences = 5;

    private bool FirstFilled => !string.IsNullOrWhiteSpace(manualUrls[0]);
    private bool SecondFilled => !string.IsNullOrWhiteSpace(manualUrls[1]);

    private bool showSecondBox;
    private bool showRestOfForm;
    private bool randomizeFading;
    private bool randomizeRowHiddenAfterFirstEntry;
    private bool wrapperCollapsing;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsageStatusAsync();
    }

    private async Task LoadUsageStatusAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState?.User?.Identity?.IsAuthenticated != true)
        {
            usageStatus = null;
            return;
        }
        try
        {
            usageStatus = await Http.GetFromJsonAsync<UsageStatusResponse>("api/usage/status");
        }
        catch
        {
            usageStatus = null;
        }
    }

    private void OnFirstInputBlur()
    {
        CloseSuggestionsAfterDelay(0);
        if (FirstFilled)
            showSecondBox = true;
    }

    private static int CountWords(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return 0;
        return text.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries).Length;
    }

    private int AdditionalPromptWordCount => CountWords(additionalPrompt);

    private static string TrimToWordLimit(string text, int maxWords)
    {
        if (string.IsNullOrWhiteSpace(text)) return "";
        var words = text.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries);
        if (words.Length <= maxWords) return text.Trim();
        return string.Join(" ", words.Take(maxWords));
    }

    private void OnToneSliderInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var i) && i >= 0 && i <= 2)
            selectedTone = (ArticleTone)i;
    }

    private void ToggleMoreSection()
    {
        moreSectionExpanded = !moreSectionExpanded;
        StateHasChanged();
    }

    private void OnReferenceSearchInput(ChangeEventArgs e)
    {
        referenceSearchQuery = e.Value?.ToString() ?? "";
        referenceSearchResults = null;
        referenceSearchCts?.Cancel();
        referenceSearchCts?.Dispose();
        referenceSearchCts = new CancellationTokenSource();
        var cts = referenceSearchCts;
        _ = RunReferenceSearchAsync(referenceSearchQuery, cts.Token);
    }

    private async Task RunReferenceSearchAsync(string query, CancellationToken cancel)
    {
        if (string.IsNullOrWhiteSpace(query) || query.Trim().Length < 2)
        {
            referenceSearchResults = new List<SavedArticleSummary>();
            await InvokeAsync(StateHasChanged);
            return;
        }
        referenceSearchLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var results = await Http.GetFromJsonAsync<List<SavedArticleSummary>>(
                $"api/articles/search?q={Uri.EscapeDataString(query.Trim())}&skip=0&take=10", cancel) ?? new();
            if (!cancel.IsCancellationRequested)
                referenceSearchResults = results;
        }
        catch (OperationCanceledException) { }
        finally
        {
            referenceSearchLoading = false;
            if (!cancel.IsCancellationRequested)
                await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CloseReferenceSuggestAfterDelay()
    {
        await Task.Delay(200);
        referenceSearchResults = null;
        await InvokeAsync(StateHasChanged);
    }

    private void AddReference(SavedArticleSummary article)
    {
        if (selectedReferences.Count >= MaxReferences) return;
        if (selectedReferences.Any(r => r.Slug == article.Slug)) return;
        selectedReferences.Add(new ReferenceLink { Title = article.Title, Slug = article.Slug });
        referenceSearchQuery = "";
        referenceSearchResults = null;
        StateHasChanged();
    }

    private void RemoveReference(ReferenceLink r)
    {
        selectedReferences.RemoveAll(x => x.Slug == r.Slug);
        StateHasChanged();
    }

    private int FilledUrlCount => manualUrls.Count(u => !string.IsNullOrWhiteSpace(u));

    private bool CanGenerate
    {
        get
        {
            if (FilledUrlCount == 0) return true;
            if (FilledUrlCount == 1) return false;
            for (int i = 0; i < 4; i++)
            {
                if (!string.IsNullOrWhiteSpace(manualUrls[i]) && manualValidation[i] == false)
                    return false;
            }
            return true;
        }
    }

    private async void OnSecondInputBlur()
    {
        await CloseSuggestionsAfterDelay(1);
        if (SecondFilled)
        {
            showRestOfForm = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnManualUrlChanged(int index, string? value)
    {
        manualUrls[index] = value ?? "";
        if (index == 0)
        {
            if (!string.IsNullOrWhiteSpace(manualUrls[0]))
            {
                if (!randomizeRowHiddenAfterFirstEntry)
                    StartRandomizeFadeOut();
            }
            else
                randomizeRowHiddenAfterFirstEntry = false;
        }
        if (index == 1 && string.IsNullOrWhiteSpace(manualUrls[1]))
            showRestOfForm = false;
        manualValidation[index] = null;

        suggestCts[index]?.Cancel();
        suggestCts[index]?.Dispose();
        suggestCts[index] = new CancellationTokenSource();
        var cts = suggestCts[index];
        _ = RunSearchAfterDelayAsync(index, value ?? "", cts!.Token);
    }

    private async Task RunSearchAfterDelayAsync(int index, string value, CancellationToken cancel)
    {
        try { await Task.Delay(300, cancel); }
        catch (OperationCanceledException) { return; }

        if (string.IsNullOrWhiteSpace(value) || value.Trim().Length < 2)
        {
            suggestions[index] = new List<string>();
            await InvokeAsync(StateHasChanged);
            return;
        }

        suggestionsLoading[index] = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var results = await Http.GetFromJsonAsync<List<string>>(
                $"api/wikipedia/search-titles?q={Uri.EscapeDataString(value.Trim())}&limit=10", cancel) ?? new();
            if (!cancel.IsCancellationRequested)
                suggestions[index] = results;
        }
        catch (OperationCanceledException) { }
        finally
        {
            suggestionsLoading[index] = false;
            if (!cancel.IsCancellationRequested)
                await InvokeAsync(StateHasChanged);
        }
    }

    private void SelectSuggestion(int index, string title)
    {
        manualUrls[index] = title;
        manualValidation[index] = null;
        suggestions[index] = null;
        if (index == 0 && !string.IsNullOrWhiteSpace(title))
        {
            showSecondBox = true;
            if (!randomizeRowHiddenAfterFirstEntry)
                StartRandomizeFadeOut();
        }
        if (index == 1 && !string.IsNullOrWhiteSpace(title))
            showRestOfForm = true;
        StateHasChanged();
    }

    private async void StartRandomizeFadeOut()
    {
        randomizeRowHiddenAfterFirstEntry = true;
        randomizeFading = true;
        StateHasChanged();
        await Task.Delay(300);
        randomizeFading = false;
        wrapperCollapsing = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(300);
        wrapperCollapsing = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task CloseSuggestionsAfterDelay(int index)
    {
        await Task.Delay(200);
        if (suggestions[index] != null)
        {
            suggestions[index] = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool SuggestionsOpen(int index)
    {
        return suggestionsLoading[index] || (suggestions[index] != null && suggestions[index]!.Count > 0);
    }

    private string ManualInputClass(int index)
    {
        return manualValidation[index] == false ? "manual-input invalid" : "manual-input";
    }

    private static string ExtractTitleFromUrl(string input)
    {
        input = input.Trim();
        if (input.Contains("wikipedia.org/wiki/", StringComparison.OrdinalIgnoreCase))
        {
            var uri = new Uri(input);
            var path = Uri.UnescapeDataString(uri.AbsolutePath);
            var title = path.Replace("/wiki/", "").Replace('_', ' ');
            return title;
        }
        return input.Replace('_', ' ');
    }

    private async Task<WikipediaPage?> GetWikipediaPageAsync(string title)
    {
        var response = await Http.GetAsync($"api/wikipedia/page?title={Uri.EscapeDataString(title)}");
        if (response.StatusCode == HttpStatusCode.NotFound) return null;
        response.EnsureSuccessStatusCode();
        return await response.Content.ReadFromJsonAsync<WikipediaPage>();
    }

    private async Task GenerateArticle()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState?.User?.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo($"Account/Login?returnUrl={Uri.EscapeDataString("/generate")}", forceLoad: true);
            return;
        }

        isLoading = true;
        isSaved = false;
        savedSlug = null;
        errorMessage = null;
        generatedArticle = null;
        sourcePages = new();
        currentStep = 0;

        try
        {
            currentStep = 1;

            List<WikipediaPage>? manualPages = null;
            if (FilledUrlCount >= 2)
            {
                statusMessage = "Validating Wikipedia articles...";
                StateHasChanged();

                var validPages = new List<WikipediaPage>();
                for (int i = 0; i < 4; i++)
                {
                    if (string.IsNullOrWhiteSpace(manualUrls[i])) continue;

                    var title = ExtractTitleFromUrl(manualUrls[i]);
                    var page = await GetWikipediaPageAsync(title);

                    if (page == null)
                    {
                        manualValidation[i] = false;
                        isLoading = false;
                        errorMessage = $"Could not find a valid Wikipedia article for input {i + 1}.";
                        StateHasChanged();
                        return;
                    }

                    manualValidation[i] = true;
                    validPages.Add(page);
                }

                if (validPages.Count < 2)
                {
                    isLoading = false;
                    errorMessage = "Please provide at least 2 valid Wikipedia articles.";
                    StateHasChanged();
                    return;
                }

                manualPages = validPages;
            }
            else
            {
                statusMessage = "Fetching Wikipedia articles...";
                StateHasChanged();
            }

            currentStep = 2;
            statusMessage = "Writing an article...";
            StateHasChanged();

            var trimmedAdditional = string.IsNullOrWhiteSpace(additionalPrompt) ? null : TrimToWordLimit(additionalPrompt.Trim(), 100);
            var refs = selectedReferences.Count > 0 ? selectedReferences : null;

            var textResponse = await Http.PostAsJsonAsync("api/generation/text", new GenerateTextRequest
            {
                SourcePages = manualPages,
                Tone = selectedTone,
                AdditionalPrompt = trimmedAdditional,
                ReferenceLinks = refs
            });

            if (textResponse.StatusCode == HttpStatusCode.Forbidden)
            {
                var error = await textResponse.Content.ReadFromJsonAsync<GenerationErrorResponse>();
                if (error?.Reason == "generation_unavailable")
                {
                    isLoading = false;
                    errorMessage = "You're out of generations. Buy more or subscribe on your Profile page.";
                    await LoadUsageStatusAsync();
                    StateHasChanged();
                    return;
                }
            }
            textResponse.EnsureSuccessStatusCode();
            var textResult = await textResponse.Content.ReadFromJsonAsync<GenerateTextResponse>();
            generatedArticle = textResult!.Article;
            sourcePages = textResult.SourcePages;
            sessionToken = textResult.SessionToken;

            currentStep = 3;
            statusMessage = "Generating an image...";
            StateHasChanged();

            var imageResponse = await Http.PostAsJsonAsync("api/generation/image", new GenerateImageRequest
            {
                ImageDescription = generatedArticle.ImageDescription,
                SessionToken = textResult.SessionToken
            });
            imageResponse.EnsureSuccessStatusCode();
            var imageResult = await imageResponse.Content.ReadFromJsonAsync<GenerateImageResponse>();
            generatedArticle.ImageDataUrl = imageResult?.ImageDataUrl;

            currentStep = 4;

            // Keep the remaining-generations count in sync after consuming one.
            await LoadUsageStatusAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Article generation failed");
            errorMessage = "Something went wrong while generating. Please try again.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SaveArticle()
    {
        if (generatedArticle == null) return;

        isSaving = true;
        try
        {
            var refs = selectedReferences.Count > 0 ? selectedReferences : null;
            var response = await Http.PostAsJsonAsync("api/articles", new SaveArticleRequest
            {
                Article = generatedArticle,
                SourcePages = sourcePages,
                ReferenceLinks = refs,
                SessionToken = sessionToken ?? ""
            });
            response.EnsureSuccessStatusCode();
            var result = await response.Content.ReadFromJsonAsync<SavedArticleSummary>();
            isSaved = true;
            savedSlug = result!.Slug;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Save article failed");
            errorMessage = "Failed to save the article. Please try again.";
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private void ReturnToGenerator()
    {
        generatedArticle = null;
        sourcePages = new();
        sessionToken = null;
        errorMessage = null;
        isSaved = false;
        savedSlug = null;
        manualUrls = new string[4] { "", "", "", "" };
        manualValidation = new bool?[4] { null, null, null, null };
        showSecondBox = false;
        showRestOfForm = false;
        randomizeRowHiddenAfterFirstEntry = false;
        randomizeFading = false;
        wrapperCollapsing = false;
        selectedTone = ArticleTone.Fun;
        additionalPrompt = "";
        selectedReferences = new List<ReferenceLink>();
        StateHasChanged();
    }

    private static string Truncate(string text, int maxLength)
    {
        if (string.IsNullOrEmpty(text) || text.Length <= maxLength)
            return text;
        return text[..maxLength].TrimEnd() + "…";
    }
}
