@page "/wiki/{Slug}"
@using InfoGen.Models
@using InfoGen.Services
@inject IArticleStorageService ArticleStorageService
@inject NavigationManager Navigation
@inject ILogger<Article> Logger

<PageTitle>@(article != null ? $"{article.Title} - Ficipedia" : "Article - Ficipedia")</PageTitle>

@if (article != null)
{
    <HeadContent>
        <meta name="description" content="@MetaDescription" />
        <link rel="canonical" href="@CanonicalUrl" />
        <meta property="og:type" content="article" />
        <meta property="og:title" content="@article.Title" />
        <meta property="og:description" content="@MetaDescription" />
        <meta property="og:url" content="@CanonicalUrl" />
        @if (!string.IsNullOrEmpty(article.ImageUrl))
        {
            <meta property="og:image" content="@article.ImageUrl" />
        }
        <meta name="twitter:card" content="@(string.IsNullOrEmpty(article.ImageUrl) ? "summary" : "summary_large_image")" />
        <meta name="twitter:title" content="@article.Title" />
        <meta name="twitter:description" content="@MetaDescription" />
        @if (!string.IsNullOrEmpty(article.ImageUrl))
        {
            <meta name="twitter:image" content="@article.ImageUrl" />
        }
    </HeadContent>
}

@if (article == null)
{
    <div class="article-page">
        <div class="wiki-article">
            <h1 class="wiki-title">Article not found</h1>
            <div class="wiki-from">From Ficipedia, the free fictional encyclopedia</div>
            <hr class="wiki-divider" />
            <div class="wiki-body">
                <p>The article "<strong>@Slug</strong>" does not exist.</p>
                <p><a href="/">Return to the home page</a> or <a href="/generate">generate a new article</a>.</p>
            </div>
        </div>
        <div class="article-page-bottom-gap" aria-hidden="true"></div>
    </div>
}
else
{
    <div class="article-page">
    <div class="wiki-article">
        <h1 class="wiki-title">@article.Title</h1>
        <div class="wiki-from">From Ficipedia, the free fictional encyclopedia</div>
        <hr class="wiki-divider" />

        <div class="wiki-content-wrapper">
            @if (!string.IsNullOrEmpty(article.ImageUrl) || article.InfoboxFacts.Count > 0)
            {
                <div class="wiki-infobox">
                    <div class="infobox-header">@article.Title</div>
                    @if (!string.IsNullOrEmpty(article.ImageUrl))
                    {
                        <div class="infobox-image">
                            <img src="@article.ImageUrl" alt="@article.Title" />
                        </div>
                        <div class="infobox-caption">@((MarkupString)ReferenceLinkRenderer.ToHtml(article.ImageDescription, article.ReferenceLinks))</div>
                    }
                    @if (article.InfoboxFacts.Count > 0)
                    {
                        <table class="infobox-facts">
                            @foreach (var fact in article.InfoboxFacts)
                            {
                                <tr>
                                    <th>@fact.Label</th>
                                    <td>@((MarkupString)ReferenceLinkRenderer.ToHtml(fact.Value, article.ReferenceLinks))</td>
                                </tr>
                            }
                        </table>
                    }
                </div>
            }

            <div class="wiki-body">
                @foreach (var articleSection in article.Sections)
                {
                    @if (articleSection.Heading != null)
                    {
                        <h2 class="wiki-section-heading">@articleSection.Heading</h2>
                    }
                    @foreach (var paragraph in articleSection.Paragraphs)
                    {
                        <p>@((MarkupString)ReferenceLinkRenderer.ToHtml(paragraph, article.ReferenceLinks))</p>
                    }
                }
            </div>
        </div>

        @if (article.SourcePages.Count > 0)
        {
            <h2 class="wiki-section-heading" id="sources">
                <span>Source Articles</span>
            </h2>
            <hr class="wiki-section-divider" />
            <p class="sources-intro">This <strong>Fictional</strong> article was generated by mashing up the following <strong>@article.SourcePages.Count</strong> real Wikipedia articles:</p>
            <ol class="wiki-references">
                @foreach (var source in article.SourcePages)
                {
                    <li>
                        <a href="@source.Url" target="_blank" rel="noopener noreferrer">@source.Title</a>
                        @if (!string.IsNullOrEmpty(source.Extract))
                        {
                            <span class="ref-extract"> — @Truncate(source.Extract, 150)</span>
                        }
                    </li>
                }
            </ol>
        }

        <div class="article-footer-meta">
            @if (!string.IsNullOrEmpty(article.CreatorDisplayName))
            {
                <p class="article-generated-by">
                    <em>Article generated by <strong class="@(article.CreatorIsSubscribed ? "author-name author-name--pro" : "author-name")">@article.CreatorDisplayName@if (article.CreatorIsSubscribed)
                    {<span class="author-star" title="Ficipedia Pro subscriber" aria-label="Subscriber">★</span>}</strong></em>
                </p>
            }
            <span class="article-views" title="Total views">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                @article.TotalViews.ToString("N0") view@(article.TotalViews == 1 ? "" : "s")
            </span>
        </div>

        <div class="article-actions">
            <a href="/random" class="btn-generate">
                Random Article
            </a>
            <div class="article-actions-pair">
                <a href="/generate" class="btn-generate btn-generate-wide">
                    Generate Article
                </a>
                <div class="share-menu-wrapper">
                    <button type="button" class="btn-share" onclick="ficipediaShare.toggleShareMenu(this)" aria-haspopup="true" aria-expanded="false">
                        Share
                    </button>
                    <div class="share-menu" hidden>
                        <button type="button" class="share-menu-item" onclick="ficipediaShare.copyCurrentLink(this)">
                            Copy link
                        </button>
                        <button type="button" class="share-menu-item" onclick="ficipediaShare.shareToX(this)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                            Share to X
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
        <div class="article-page-bottom-gap" aria-hidden="true"></div>
    </div>
}

@code {
    [Parameter]
    public string Slug { get; set; } = "";

    private SavedArticleDetail? article;

    private string CanonicalUrl => $"{Navigation.BaseUri}wiki/{Slug}";

    private string MetaDescription => Truncate(
        article?.Sections.FirstOrDefault()?.Paragraphs.FirstOrDefault() ?? "",
        160);

    protected override async Task OnInitializedAsync()
    {
        // View counting is best-effort: a failed write must never stop the article from rendering.
        // Recorded before the fetch so the count shown includes the current view. Deliberately still
        // awaited rather than fire-and-forget - the DbContext is request-scoped and would be disposed
        // out from under a detached task.
        try
        {
            await ArticleStorageService.RecordViewAsync(Slug);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to record view for article '{Slug}'", Slug);
        }

        article = await ArticleStorageService.GetArticleBySlugAsync(Slug);
    }

    private static string Truncate(string text, int maxLength)
    {
        if (string.IsNullOrEmpty(text) || text.Length <= maxLength)
            return text;
        return text[..maxLength].TrimEnd() + "…";
    }
}
