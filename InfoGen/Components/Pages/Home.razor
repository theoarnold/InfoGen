@page "/"
@using InfoGen.Models
@using InfoGen.Services
@inject IWikipediaService WikipediaService
@inject IGeminiService GeminiService
@rendermode InteractiveServer

<PageTitle>@(generatedArticle != null ? $"{generatedArticle.Title} - InfoGen" : "InfoGen - Wikipedia Mashup Generator")</PageTitle>

@if (!isLoading && generatedArticle == null)
{
    <div class="hero-section">
        <div class="hero-logo">
            <div class="logo-puzzle">
                <span>📰</span>
            </div>
            <h1>InfoGen</h1>
            <p class="hero-tagline">The AI-Powered Fake Encyclopedia</p>
        </div>
        <p class="hero-description">
            InfoGen fetches 4 random Wikipedia articles and uses <strong>Google Gemini</strong> to mash them
            into a single, cohesive (but totally fake) encyclopedia entry — complete with an AI-generated image
            powered by <strong>Nano Banana</strong>.
        </p>
        <button class="btn-generate" @onclick="GenerateArticle" disabled="@isLoading">
            <span class="btn-icon">🎲</span>
            Generate Mashup Article
        </button>
    </div>
}
else if (isLoading)
{
    <div class="loading-section">
        <div class="loading-spinner">
            <div class="spinner"></div>
        </div>
        <p class="loading-status">@statusMessage</p>
        <div class="loading-steps">
            <div class="step @(currentStep >= 1 ? "active" : "") @(currentStep > 1 ? "done" : "")">
                <span class="step-icon">@(currentStep > 1 ? "✅" : "📡")</span>
                <span>Fetching Wikipedia pages</span>
            </div>
            <div class="step @(currentStep >= 2 ? "active" : "") @(currentStep > 2 ? "done" : "")">
                <span class="step-icon">@(currentStep > 2 ? "✅" : "🤖")</span>
                <span>Generating mashup article</span>
            </div>
            <div class="step @(currentStep >= 3 ? "active" : "") @(currentStep > 3 ? "done" : "")">
                <span class="step-icon">@(currentStep > 3 ? "✅" : "🎨")</span>
                <span>Creating image with Nano Banana</span>
            </div>
        </div>
    </div>
}

@if (generatedArticle != null && !isLoading)
{
    <div class="wiki-article">
        <h1 class="wiki-title">@generatedArticle.Title</h1>
        <div class="wiki-from">From InfoGen, the free fake encyclopedia</div>
        <hr class="wiki-divider" />

        <div class="wiki-content-wrapper">
            @if (!string.IsNullOrEmpty(generatedArticle.ImageDataUrl) || generatedArticle.InfoboxFacts.Count > 0)
            {
                <div class="wiki-infobox">
                    <div class="infobox-header">@generatedArticle.Title</div>
                    @if (!string.IsNullOrEmpty(generatedArticle.ImageDataUrl))
                    {
                        <div class="infobox-image">
                            <img src="@generatedArticle.ImageDataUrl" alt="@generatedArticle.Title" />
                        </div>
                        <div class="infobox-caption">@generatedArticle.ImageDescription</div>
                    }
                    @if (generatedArticle.InfoboxFacts.Count > 0)
                    {
                        <table class="infobox-facts">
                            @foreach (var fact in generatedArticle.InfoboxFacts)
                            {
                                <tr>
                                    <th>@fact.Label</th>
                                    <td>@fact.Value</td>
                                </tr>
                            }
                        </table>
                    }
                </div>
            }

            <div class="wiki-body">
                @foreach (var articleSection in generatedArticle.Sections)
                {
                    @if (articleSection.Heading != null)
                    {
                        <h2 class="wiki-section-heading">@articleSection.Heading</h2>
                    }
                    @foreach (var paragraph in articleSection.Paragraphs)
                    {
                        <p>@paragraph</p>
                    }
                }
            </div>
        </div>

        <h2 class="wiki-section-heading" id="sources">
            <span>Source Articles</span>
        </h2>
        <hr class="wiki-section-divider" />
        <p class="sources-intro">This article was generated by mashing up the following <strong>@sourcePages.Count</strong> real Wikipedia articles:</p>
        <ol class="wiki-references">
            @foreach (var sourcePage in sourcePages)
            {
                <li>
                    <a href="@sourcePage.Url" target="_blank" rel="noopener noreferrer">@sourcePage.Title</a>
                    <span class="ref-extract"> — @Truncate(sourcePage.Extract, 150)</span>
                </li>
            }
        </ol>

        <div class="article-actions">
            <button class="btn-generate" @onclick="GenerateArticle" disabled="@isLoading">
                <span class="btn-icon">🎲</span>
                Generate Another
            </button>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="error-banner">
        <span class="error-icon">⚠️</span>
        <div>
            <strong>Something went wrong</strong>
            <p>@errorMessage</p>
        </div>
        <button class="btn-generate btn-small" @onclick="GenerateArticle">Try Again</button>
    </div>
}

@code {
    private GeneratedArticle? generatedArticle;
    private List<WikipediaPage> sourcePages = new();
    private bool isLoading;
    private string statusMessage = "";
    private string? errorMessage;
    private int currentStep;

    private async Task GenerateArticle()
    {
        isLoading = true;
        errorMessage = null;
        generatedArticle = null;
        sourcePages = new();
        currentStep = 0;

        try
        {
            // Step 1: Fetch random Wikipedia pages
            currentStep = 1;
            statusMessage = "Fetching 4 random Wikipedia articles...";
            StateHasChanged();

            sourcePages = await WikipediaService.GetRandomPagesAsync(4);

            // Step 2: Generate mashup article with Gemini
            currentStep = 2;
            statusMessage = "Gemini is writing a mashup article...";
            StateHasChanged();

            generatedArticle = await GeminiService.GenerateMashupArticleAsync(sourcePages);

            // Step 3: Generate image with Nano Banana
            currentStep = 3;
            statusMessage = "Nano Banana is generating an image...";
            StateHasChanged();

            var imageDataUrl = await GeminiService.GenerateImageAsync(generatedArticle.ImageDescription);
            generatedArticle.ImageDataUrl = imageDataUrl;

            currentStep = 4;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private static string Truncate(string text, int maxLength)
    {
        if (string.IsNullOrEmpty(text) || text.Length <= maxLength)
            return text;
        return text[..maxLength].TrimEnd() + "…";
    }
}
