@page "/Account/Profile"

@using Microsoft.AspNetCore.Identity
@using InfoGen.Data
@using InfoGen.Services
@using InfoGen.Components.Account.Shared

@inject UserManager<ApplicationUser> UserManager
@inject IServiceProvider ServiceProvider

<PageTitle>Profile - Ficipedia</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="account-page">
            <h1>Profile</h1>
            <p class="account-subheading">
                Hello, @(context.User.Identity?.Name ?? "User")!
            </p>

            <p class="generations-available">
                You have <strong>@totalAvailable</strong> generation@(totalAvailable == 1 ? "" : "s") available.
            </p>

            @if (!string.IsNullOrEmpty(statusMessage))
            {
                <div class="account-alert @statusClass" role="alert">@statusMessage</div>
            }

            <div class="credit-packages-section">
                <h2>Buy Generations</h2>
                <p class="subscription-info">One-time top-ups. Purchased credits never expire — and every purchase helps keep Ficipedia running.</p>
                @if (stripeConfigured)
                {
                    <div class="credit-packages">
                        <div class="credit-package-card">
                            <div class="credit-package-count">3</div>
                            <div class="credit-package-label">generations</div>
                            <div class="credit-package-price">$3</div>
                            <form method="post" action="/stripe/create-credit-checkout">
                                <AntiforgeryToken />
                                <input type="hidden" name="packSize" value="3" />
                                <button type="submit" class="credit-package-btn">Buy</button>
                            </form>
                        </div>
                        <div class="credit-package-card">
                            <div class="credit-package-count">10</div>
                            <div class="credit-package-label">generations</div>
                            <div class="credit-package-price">$5</div>
                            <form method="post" action="/stripe/create-credit-checkout">
                                <AntiforgeryToken />
                                <input type="hidden" name="packSize" value="10" />
                                <button type="submit" class="credit-package-btn">Buy</button>
                            </form>
                        </div>
                        <div class="credit-package-card credit-package-card--best">
                            <div class="best-value-badge">Best Value</div>
                            <div class="credit-package-count">25</div>
                            <div class="credit-package-label">generations</div>
                            <div class="credit-package-price">$9</div>
                            <form method="post" action="/stripe/create-credit-checkout">
                                <AntiforgeryToken />
                                <input type="hidden" name="packSize" value="25" />
                                <button type="submit" class="credit-package-btn credit-package-btn--best">Buy</button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <p class="subscription-info" style="color: #72777d;">Purchases are not yet available.</p>
                }
            </div>

            <div class="profile-subscription">
                <div class="subscription-header">
                    <h2>Subscription</h2>
                    @if (subscriptionStatus == "active")
                    {
                        <div class="subscription-badge active">Active</div>
                    }
                    else
                    {
                        <div class="subscription-badge inactive">Inactive</div>
                    }
                </div>
                @if (subscriptionStatus == "active")
                {
                    <p class="subscription-info">You have an active Ficipedia Generator subscription — 100 generations every month, plus other perks. Thank you for supporting Ficipedia and helping keep it running!</p>
                    <form method="post" action="/stripe/create-portal" class="subscription-form">
                        <AntiforgeryToken />
                        <button type="submit" class="account-external-btn subscription-manage-btn">Manage Subscription</button>
                    </form>
                }
                else
                {
                    <p class="subscription-info">Subscribe for <strong>$11/month</strong> — 100 generations every month, plus other perks. Your subscription directly supports Ficipedia and keeps the servers running.</p>
                    @if (stripeConfigured)
                    {
                        <form method="post" action="/stripe/create-checkout" class="subscription-form">
                            <AntiforgeryToken />
                            <button type="submit" class="account-external-btn subscription-subscribe-btn">Subscribe</button>
                        </form>
                    }
                    else
                    {
                        <p class="subscription-info" style="color: #72777d;">Subscriptions are not yet available.</p>
                    }
                }
            </div>

            <div class="profile-username-section">
                <h2>Username</h2>
                <p class="subscription-info">This name appears as the author on articles you generate. Leave blank to use your email. Must be unique.</p>
                <form method="post" action="Account/UpdateDisplayName" class="profile-username-form">
                    <AntiforgeryToken />
                    <input type="text" name="displayName" class="profile-username-input" placeholder="Your email (if left blank)" value="@(displayName ?? userEmail ?? "")" maxlength="256" />
                    <button type="submit" class="account-external-btn subscription-manage-btn">Save username</button>
                </form>
            </div>

            <form method="post" action="Account/Logout" class="account-logout-form">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="/" />
                <button type="submit" class="account-external-btn account-logout-btn">Log out</button>
            </form>
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private string subscriptionStatus = "none";
    private bool stripeConfigured;
    private string? statusMessage;
    private string statusClass = "success";
    private string? displayName;
    private string? userEmail;
    private int totalAvailable;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "status")]
    private string? Status { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var stripeService = ServiceProvider.GetService<IStripeService>();
        stripeConfigured = stripeService is not null;
        var usageService = ServiceProvider.GetRequiredService<IUsageService>();

        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is not null)
        {
            userEmail = user.Email ?? user.UserName;
            displayName = user.DisplayName ?? "";
            if (stripeService is not null)
                subscriptionStatus = await stripeService.GetSubscriptionStatusAsync(user);

            var isSubscribed = subscriptionStatus == "active";
            var remainingThisMonth = await usageService.GetRemainingGenerationsAsync(user.Id);
            var purchasedCredits = await usageService.GetPurchasedCreditsAsync(user.Id);
            var trialAvailable = !await usageService.HasEverGeneratedAsync(user.Id);
            totalAvailable = (isSubscribed ? remainingThisMonth : 0) + purchasedCredits + (trialAvailable ? 1 : 0);
        }

        if (!string.IsNullOrEmpty(Status))
        {
            (statusMessage, statusClass) = Status switch
            {
                "subscribed" => ("Successfully subscribed! You can now generate articles.", "success"),
                "credits_purchased" => ("Thanks! Your generations have been added to your account.", "success"),
                "cancelled" => ("Checkout was cancelled.", "danger"),
                "invalid_pack" => ("That package is not available. Please try again.", "danger"),
                "subscribe_required" => ("You need an active subscription to generate articles. Subscribe below!", "danger"),
                "username_updated" => ("Username updated.", "success"),
                "username_cleared" => ("Username cleared. Your email will be shown on new articles.", "success"),
                "username_taken" => ("That username is already taken. Please choose another.", "danger"),
                _ => (null, "success")
            };
        }
    }
}
