@inject NavigationManager NavigationManager

@code {
    protected override void OnInitialized()
    {
        var returnPath = "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri).TrimStart('/');
        if (string.IsNullOrEmpty(returnPath) || returnPath == "/") returnPath = "/Account/Profile";
        NavigationManager.NavigateTo($"Account/Login?returnUrl={Uri.EscapeDataString(returnPath)}", forceLoad: true);
    }
}
