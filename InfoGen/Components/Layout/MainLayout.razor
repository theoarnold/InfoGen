@inherits LayoutComponentBase

<div class="page-wrapper">
    <header class="site-header">
        <div class="header-content">
            <a class="site-brand" href="">
                <span class="brand-text">InfoGen</span>
            </a>
            <span class="header-tagline">The AI-Powered Fake Encyclopedia</span>
        </div>
    </header>

    <main class="main-content">
        @Body
    </main>

    <footer class="site-footer">
        <p>Powered by <strong>Wikipedia API</strong>, <strong>Google Gemini</strong>, and <strong>Nano Banana</strong> image generation.</p>
        <p class="footer-disclaimer">All generated articles are fictional. For entertainment purposes only.</p>
    </footer>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
