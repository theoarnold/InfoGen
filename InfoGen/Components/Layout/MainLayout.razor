@inherits LayoutComponentBase

<div class="page-wrapper">
    <header class="site-header">
        <div class="header-content">
            <a class="site-brand" href="">
                <span class="brand-text">Ficipedia</span>
            </a>
            <span class="header-tagline">the fictional encyclopedia</span>
            <form class="header-search" action="/" method="get">
                <input type="text" name="q" placeholder="Search articles..." class="header-search-input" />
                <button type="submit" class="header-search-btn">Search</button>
            </form>
        </div>
    </header>

    <main class="main-content">
        @Body
    </main>

</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
